PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=guildchat
DB_SSLMODE=disable

# RSA keys used to sign/verify JWTs.
# Relative paths resolve against the working directory (app/ for `make run`).
JWT_PRIVATE_KEY_PATH=../keys/private.pem
JWT_PUBLIC_KEY_PATH=../keys/public.pem
